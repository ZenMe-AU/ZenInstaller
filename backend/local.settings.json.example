{
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "node",
    "AzureWebJobsStorage": "",
    "ALLOWED_ORIGINS": "http://localhost:5173,https://www.zeninstaller.com",
    "GITHUB_TOKEN": "",
    "FUNCTION_TENANT_ID": "<the tenant the Function App lives in>",
    "FUNCTION_CLIENT_ID": "<app registration that exposes api://.../access_as_user>",
    "FUNCTION_CLIENT_SECRET": "<local only; leave unset in Azure to use the managed identity>",
    "WEBPUBSUB_ENDPOINT": "<your-webpubsub-hostname>",
    "WEBPUBSUB_RESOURCE_ID": "<local only; in Azure it is derived from WEBSITE_OWNER_NAME and WEBSITE_RESOURCE_GROUP>",
    "HUB_NAME": "terminal",
    "SESSION_TABLE_ACCOUNT_NAME": "<your-storage-account>",
    "SESSION_TABLE_NAME": "sessions",
    "GITHUB_OAUTH_CLIENT_SECRET": "<your-github-oauth-app-client-secret>"
  }
}
